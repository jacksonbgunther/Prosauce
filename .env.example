# Supabase project (free tier) that holds the `signups` table.
# Project Settings -> API. Use the service_role key (server-side only, never expose it in the browser).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Password for /admin/signups
ADMIN_PASSWORD=

# Local development only: store signups in a JSON file instead of Supabase.
# SIGNUPS_DEV_FILE=.signups.dev.json
