{%- liquid
  assign t = page_title
  if template.name == 'index' or t == blank
    assign t = "Toon Sauce | Your favorite sauce, now with 70g of protein"
  elsif template.name == 'password'
    assign t = "Toon Sauce | Your favorite sauce, now with 70g of protein"
  else
    assign t = page_title | append: ' | Toon Sauce'
  endif
  assign d = page_description | default: "Restaurant-style chicken sauce made with real honey. 7g protein per serving, 70g per bottle. Join the list for launch-day access."
  if template.name == 'index'
    assign d = "Restaurant-style chicken sauce made with real honey. 7g protein per serving, 70g per bottle. Join the list for launch-day access."
  endif
-%}
<title>{{ t | escape }}</title>
<meta name="description" content="{{ d | escape }}">
<meta property="og:title" content="{{ t | escape }}">
<meta property="og:description" content="{{ d | escape }}">
<meta property="og:image" content="https:{{ 'hero-pour-cream-soft.jpg' | asset_url }}">
<meta name="theme-color" content="#141414">
<link rel="icon" href="{{ 'favicon.png' | asset_url }}">
<link rel="canonical" href="{{ canonical_url }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Lilita+One&amp;family=Fredoka:wght@400;500;600;700&amp;family=Shrikhand&amp;display=swap" rel="stylesheet">
{{ 'toon.css' | asset_url | stylesheet_tag }}
<script>window.TOON={leadEndpoint:{{ settings.lead_endpoint | json }}};</script>
{{ content_for_header }}
</head>
<body>
<div class="dk" style="font-family: 'Fredoka', system-ui, sans-serif; color: #F6EEDF; background: #141414; overflow-x: clip">
{% section 'toon-header' %}
{{ content_for_layout }}
{% section 'toon-footer' %}
</div>
<div id="cookie-note" hidden role="region" aria-label="Cookie notice" style="position:fixed;left:16px;right:16px;bottom:16px;z-index:50;max-width:440px;display:flex;align-items:center;gap:14px;padding:12px 12px 12px 18px;border-radius:16px;background:rgba(28,28,28,.96);border:1px solid rgba(246,238,223,.16);color:#F6EEDF;font-family:Fredoka,system-ui,sans-serif;font-size:14px;line-height:1.45;box-shadow:0 16px 40px rgba(0,0,0,.45)"><span>We use cookies and the Meta Pixel to measure our ads. <a href="/pages/privacy" style="color:inherit">Privacy Policy</a></span><button type="button" style="flex:0 0 auto;min-width:64px;min-height:44px;border-radius:999px;border:0;background:#F2A93B;color:#141414;font:600 14px Fredoka,system-ui,sans-serif;cursor:pointer">OK</button></div>
<script src="{{ 'toon.js' | asset_url }}" defer></script>
</body>
